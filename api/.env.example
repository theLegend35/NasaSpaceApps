# Copy to api/.env. Never commit the real file.
ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000

# AI tutor (server side only). Without these the tutor shows "offline" and the rest works.
XAI_API_KEY=
XAI_MODEL=

# Candidate store (API writes with the service key; browser reads under RLS).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
